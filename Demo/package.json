{
  "name": "professional-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "wrangler types --include-runtime false && tsc --noEmit && tsc -p tsconfig.client.json --noEmit && vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-mission-control-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-mission-control-db --remote",
    "types": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "agents": "0.28.1",
    "hono": "^4.10.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
