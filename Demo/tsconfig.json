{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "./worker-configuration.d.ts"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": false
  },
  "include": ["src/**/*.ts", "vite.config.ts"],
  "exclude": ["src/client"]
}
